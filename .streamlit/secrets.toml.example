OPENAI_API_KEY = "your_openai_api_key_here"
OPENAI_MODEL = "gpt-5.4"
ADMIN_EMAILS = "c2a2.thomas.loughran@gmail.com"
AUTH_PROVIDER_NAME = "google"

[auth]
