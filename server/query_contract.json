{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2A2 AI Query Contract",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "current_filters": {
          "type": "object",
          "properties": {
            "search": { "type": "string" },
            "types": { "type": "array", "items": { "type": "string" } },
            "subtypes": { "type": "array", "items": { "type": "string" } },
            "country": { "type": "string" },
            "source": { "type": "string" },
            "manualOnly": { "type": "boolean" },
            "geoOnly": { "type": "boolean" }
          },
          "required": ["search", "types", "subtypes", "country", "source", "manualOnly", "geoOnly"]
        },
        "conversation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "text": { "type": "string" }
            },
            "required": ["role", "text"]
          }
        },
        "mode": {
          "type": "string",
          "enum": ["database_only", "database_plus_web"]
        }
      },
      "required": ["prompt", "current_filters", "mode", "conversation"]
    },
    "response": {
      "type": "object",
      "properties": {
        "assistantMode": { "type": "string" },
        "transport": { "type": "string" },
        "searchScope": {
          "type": "string",
          "enum": ["database_only", "database_plus_web"]
        },
        "answerMarkdown": { "type": "string" },
        "warning": { "type": "string" },
        "suggestedFilters": {
          "type": "object",
          "properties": {
            "search": { "type": "string" },
            "types": { "type": "array", "items": { "type": "string" } },
            "subtypes": { "type": "array", "items": { "type": "string" } },
            "country": { "type": "string" },
            "source": { "type": "string" },
            "manualOnly": { "type": "boolean" },
            "geoOnly": { "type": "boolean" }
          }
        },
        "recommendedIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rankedMatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "communityId": { "type": "string" },
              "communityName": { "type": "string" },
              "score": { "type": "number" },
              "reason": { "type": "string" }
            },
            "required": ["communityId", "communityName", "score", "reason"]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "communityId": { "type": "string" },
              "communityName": { "type": "string" },
              "sourceUrl": { "type": "string" },
              "excerpt": { "type": "string" },
              "provenance": { "type": "string" }
            },
            "required": ["communityId", "sourceUrl", "excerpt", "provenance"]
          }
        },
        "followUpSuggestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "note": { "type": "string" }
            },
            "required": ["title", "url", "note"]
          }
        },
        "mutations": {
          "type": "object",
          "properties": {
            "createdCommunityIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "createdCommunities": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "datasetTotalRecords": {
              "type": "integer"
            }
          }
        }
      },
      "required": ["assistantMode", "searchScope", "answerMarkdown", "recommendedIds", "rankedMatches", "evidence", "followUpSuggestions"]
    }
  },
  "required": ["request", "response"]
}
